{
  "name": "@takusu/client",
  "version": "0.20260725.2",
  "private": true,
  "description": "Shared TypeScript client and types for the takusu REST API (mirrors the takusu-client Rust crate). Used by the mobile and web frontends.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:types": "openapi-typescript openapi/openapi.json -o src/types.gen.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
