# This is a template. The Nix package and the Home Manager module substitute
# @takusu_desktop@ with the actual store path at build/evaluation time.
[Unit]
Description=takusu resident desktop daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=@takusu_desktop@
Restart=on-failure
Environment="RUST_LOG=info,takusu_desktop=debug"
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectHome=read-only
ProtectSystem=strict
StateDirectory=takusu
ReadWritePaths=%S/takusu %t
PrivateTmp=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=default.target
