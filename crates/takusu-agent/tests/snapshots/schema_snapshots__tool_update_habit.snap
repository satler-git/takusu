            },
            "required": [
              "field",
              "value",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "parallelizable": {
          "type": "boolean"
        },
        "proposal_id": {
          "description": "Optional proposal id. Set the same value across multiple related tool calls to group them into a single proposal for review.",
          "type": "string"
        },
        "recurrence": {
          "type": "string"
        },
        "sigma_minutes": {
          "type": "integer"
        },
        "start_time": {
          "description": "Time of day (HH:MM).",
          "type": "string"
        },
        "steps": {
          "description": "Ordered steps for a multi-step habit. Existing step ids are omitted; match by position on update.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "abandonability": {
                "description": "A value in [0.0, 1.0]; out-of-range values are silently clamped.",
                "type": "number"
              },
              "allows_parallel": {
                "type": "boolean"
              },
