{
  "function": {
    "description": "Create a recurring habit update proposal. Calling this tool generates a pending approval request; it does not write immediately.",
    "name": "update_habit",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "abandonability": {
          "description": "A value in [0.0, 1.0]; out-of-range values are silently clamped.",
