                "type": "integer"
              },
              "depends_on": {
                "description": "Display positions (1-indexed) of steps this step depends on.",
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "description": {
                "type": "string"
              },
              "end_time": {
                "description": "Time of day (HH:MM).",
                "type": "string"
              },
              "fixed": {
                "type": "boolean"
              },
              "parallelizable": {
                "type": "boolean"
              },
              "position": {
                "description": "1-indexed display position of the step within the habit. On update, matching existing positions update existing steps; new positions create new steps.",
                "type": "integer"
              },
              "sigma_minutes": {
                "type": "integer"
              },
              "start_time": {
                "description": "Time of day (HH:MM).",
                "type": "string"
              },
