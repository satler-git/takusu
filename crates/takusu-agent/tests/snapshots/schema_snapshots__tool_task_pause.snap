      "additionalProperties": false,
      "properties": {
        "task_ref": {
          "description": "Task reference such as #42 or h1#3. Omit if the user did not specify a task; a focused clarification will be returned.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "type": "function"
}
